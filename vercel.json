{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:production",
  "devCommand": "pnpm dev:web",
  "outputDirectory": "dist/client",
  "routes": [
    {
      "src": "^(/api(?:/.*)?)$",
      "dest": "/api/handler",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "$1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
