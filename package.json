{
  "name": "vocabflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:api": "tsx --env-file=.env apps/api/src/local-dev.ts",
    "dev:all": "concurrently -n web,api -c cyan,yellow \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:vercel": "vercel dev --local --listen 3000",
    "dev:web": "vite --config apps/web/vite.config.mts --host 127.0.0.1",
    "build:workspace-packages": "tsc -p packages/contracts/tsconfig.build.json && esbuild packages/contracts/src/index.ts --format=cjs --platform=node --target=node22 --outfile=packages/contracts/dist/index.cjs && tsc -p packages/learning-domain/tsconfig.build.json && esbuild packages/learning-domain/src/index.ts --format=cjs --platform=node --target=node22 --outfile=packages/learning-domain/dist/index.cjs",
    "build:api-runtime": "vite build --config apps/api/vite.config.mts && tsc -p apps/api/tsconfig.runtime-build.json",
    "build:runtime": "pnpm build:workspace-packages && pnpm build:api-runtime",
    "postinstall": "pnpm build:runtime",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "pnpm build:runtime && vite build --config apps/web/vite.config.mts",
    "postbuild": "tsx scripts/postbuild.ts",
    "build:production": "tsx scripts/production-build.ts",
    "deploy:preview": "tsx scripts/deploy-vercel.ts preview",
    "deploy:production": "tsx scripts/deploy-vercel.ts production",
    "preview": "vite preview",
    "db:check": "tsx scripts/db-check.ts",
    "db:bootstrap-preflight": "tsx scripts/db-preflight.ts bootstrap",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap-cli.ts",
    "db:identity-provision": "tsx scripts/db-identity-provision.ts",
    "db:production-bootstrap": "tsx scripts/db-production-bootstrap.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:production-preflight": "tsx scripts/db-production-preflight.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "dataset:validate": "tsx scripts/validate-dataset.ts",
    "validate:master-vocab-v2": "tsx scripts/validate-master-vocabulary-v2.ts",
    "transform:master-vocab-v2": "tsx scripts/transform-master-vocabulary-v2.ts",
    "import:master-vocab-v2": "tsx scripts/import-master-vocabulary-v2.ts",
    "scan:master-vocab-v2-development-reconciliation": "tsx scripts/master-vocabulary-v2-development-reconciliation-scan.ts",
    "verify:master-vocab-v2-post-apply": "tsx scripts/master-vocabulary-v2-post-apply-verification.ts",
    "audit:development-legacy-vocabulary": "tsx scripts/development-legacy-vocabulary-cleanup-audit.ts",
    "audit:legacy-semantic-exclusion-closure": "tsx scripts/development-legacy-semantic-exclusion-closure.ts",
    "audit:legacy-reference-retirement-plan": "tsx scripts/development-legacy-reference-retirement-plan.ts",
    "plan:legacy-master-expansion": "tsx scripts/legacy-master-expansion-plan.ts",
    "source-proof:master-vocab-v2-hybrid-100": "python scripts/master-vocabulary-v2-hybrid-source-proof.py",
    "vocab:hybrid-100-editorial": "tsx scripts/hybrid-100-editorial-draft.ts",
    "vocab:hybrid-100-editorial-review": "tsx scripts/hybrid-100-editorial-review.ts",
    "vocab:hybrid-100-promote": "tsx scripts/hybrid-100-canonical-promote.ts",
    "vocab:hybrid-100-cefr-draft": "tsx scripts/hybrid-100-cefr-draft.ts",
    "vocab:hybrid-100-cefr-owner-review-closure": "tsx scripts/hybrid-100-cefr-owner-review-closure.ts",
    "vocab:hybrid-100-cefr-full-owner-approval": "tsx scripts/hybrid-100-cefr-full-owner-approval.ts",
    "vocab:hybrid-100-release-candidate": "tsx scripts/hybrid-100-release-candidate.ts",
    "vocab:hybrid-100-rc-final-audit": "tsx scripts/hybrid-100-rc-final-audit.ts",
    "test:vocab:hybrid-100-canary-integrity": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-canary-integrity.test.ts",
    "test:vocab:hybrid-100-rc-final-audit": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-rc-final-audit.test.ts",
    "test:vocab:hybrid-100-runtime-eligibility-closure": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-runtime-eligibility-closure.test.ts",
    "vocab:hybrid-100-approved-release": "tsx scripts/hybrid-100-approved-release.ts",
    "test:vocab:hybrid-100-approved-release": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-approved-release.test.ts",
    "vocab:hybrid-100-runtime-eligible-patch-release": "tsx scripts/hybrid-100-runtime-eligible-patch-release.ts",
    "test:vocab:hybrid-100-runtime-eligible-patch-release": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-runtime-eligible-patch-release.test.ts",
    "vocab:hybrid-100-owner-reconciliation-proposal": "tsx scripts/hybrid-100-owner-reconciliation-proposal.ts",
    "vocab:hybrid-100-owner-reconciliation-dry-run": "tsx scripts/hybrid-100-owner-reconciliation-dry-run.ts",
    "test:vocab:hybrid-100-owner-reconciliation-proposal": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism scripts/hybrid-100-owner-reconciliation-proposal.test.ts",
    "test:master-vocab-v2-hybrid-source-proof": "python scripts/master-vocabulary-v2-hybrid-source-proof.test.py",
    "prepare:master-vocab-v2-canary": "tsx scripts/master-vocabulary-v2-canary-preparation.ts",
    "dataset:prepare-canary-v2": "tsx scripts/master-vocabulary-v2-canary-release-builder.ts",
    "vocab:import-catalog": "tsx scripts/import-vocabulary-catalog.ts",
    "vocab:curate": "tsx scripts/vocabulary-curation.ts",
    "vocab:enrich-starter": "tsx scripts/enrich-starter-vocabulary.ts",
    "media:manifest": "tsx scripts/vocab-media-manifest.ts",
    "media:upload": "tsx scripts/vocab-media-upload.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vocabflow/contracts": "workspace:*",
    "@vocabflow/learning-domain": "workspace:*",
    "better-auth": "1.7.3",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "uuid": "14.0.2",
    "vercel": "59.15.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
