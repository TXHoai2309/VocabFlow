{
  "name": "vocabflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.mts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "vite build --config apps/web/vite.config.mts",
    "preview": "vite preview",
    "db:check": "tsx scripts/db-check.ts",
    "db:bootstrap-preflight": "tsx scripts/db-preflight.ts bootstrap",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap-cli.ts",
    "db:identity-provision": "tsx scripts/db-identity-provision.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "dataset:validate": "tsx scripts/validate-dataset.ts",
    "media:manifest": "tsx scripts/vocab-media-manifest.ts",
    "media:upload": "tsx scripts/vocab-media-upload.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vocabflow/contracts": "workspace:*",
    "@vocabflow/learning-domain": "workspace:*",
    "better-auth": "1.7.3",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
