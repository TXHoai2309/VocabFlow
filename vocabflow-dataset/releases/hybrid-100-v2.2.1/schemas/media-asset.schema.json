{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/media-asset.schema.json",
  "title": "VocabFlow Master Media Asset slot, versions, and deliveries",
  "type": "object",
  "properties": {
    "mediaAssetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "targetEntityType": { "type": "string", "enum": ["LEXEME", "SENSE", "EXAMPLE"] },
    "targetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "mediaKind": { "type": "string", "enum": ["IMAGE", "WORD_PRONUNCIATION_AUDIO", "EXAMPLE_AUDIO"] },
    "semanticBrief": { "$ref": "common.schema.json#/$defs/localizedTextList" },
    "styleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
    "status": {
      "type": "string",
      "enum": ["PLANNED", "IN_PROGRESS", "IN_REVIEW", "APPROVED", "REJECTED", "RETIRED", "NOT_APPLICABLE"]
    },
    "currentMediaAssetVersion": { "type": "integer", "minimum": 1 },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/mediaAssetVersion" },
      "uniqueItems": true
    },
    "deliveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/mediaDelivery" },
      "uniqueItems": true
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["mediaAssetId", "targetEntityType", "targetId", "mediaKind", "semanticBrief", "status", "versions", "deliveries", "createdAt", "updatedAt"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] },
      "then": { "required": ["currentMediaAssetVersion"], "properties": { "versions": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } }, "required": ["status"] },
      "then": { "not": { "required": ["currentMediaAssetVersion"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "mediaAssetVersion": {
      "type": "object",
      "properties": {
        "mediaAssetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "mediaAssetVersion": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "mimeType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sourceType": { "type": "string", "enum": ["GENERATED", "LICENSED_SOURCE", "PUBLIC_DOMAIN_SOURCE", "OWNER_SUPPLIED", "PROJECT_AUTHORED"] },
        "sourceLocator": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "licenseId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "attribution": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/localizedText" }, "uniqueItems": true },
        "prompt": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "generationProvider": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "model": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "generationSettings": { "type": "object" },
        "audioText": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "locale": { "$ref": "common.schema.json#/$defs/languageTag" },
        "accentCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "voiceId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "qaStatus": { "type": "string", "enum": ["PENDING", "PASSED", "FAILED"] },
        "qaNotes": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "reviewedBy": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "reviewedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "supersedesMediaAssetVersion": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED"] }
      },
      "required": ["mediaAssetId", "mediaAssetVersion", "status"],
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] },
          "then": {
            "required": ["sha256", "mimeType", "byteLength", "sourceType", "sourceLocator", "qaStatus", "reviewedBy", "reviewedAt"],
            "properties": { "qaStatus": { "const": "PASSED" } }
          }
        },
        {
          "if": { "properties": { "sourceType": { "const": "GENERATED" } }, "required": ["sourceType"] },
          "then": { "required": ["prompt", "generationProvider", "model"] }
        }
      ],
      "additionalProperties": false
    },
    "mediaDelivery": {
      "type": "object",
      "properties": {
        "deliveryId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "mediaAssetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "mediaAssetVersion": { "type": "integer", "minimum": 1 },
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "providerDeliveryId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "deliveryStatus": { "type": "string", "enum": ["PENDING", "READY", "FAILED", "RETIRED"] }
      },
      "required": ["deliveryId", "mediaAssetId", "mediaAssetVersion", "provider", "providerDeliveryId", "deliveryStatus"],
      "allOf": [
        {
          "if": { "properties": { "deliveryStatus": { "const": "READY" } }, "required": ["deliveryStatus"] },
          "then": { "required": ["url"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
