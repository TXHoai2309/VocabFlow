{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/provenance.schema.json",
  "title": "VocabFlow Master Provenance record",
  "type": "object",
  "properties": {
    "provenanceId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "subjectType": {
      "type": "string",
      "enum": ["LEXEME", "SENSE", "LINGUISTIC_CHILD", "CLASSIFICATION", "RELATION", "MEDIA_ASSET_VERSION", "TAXONOMY_RECORD", "LEARNING_SET"]
    },
    "subjectId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "fieldPath": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "sourceType": {
      "type": "string",
      "enum": ["PROJECT_AUTHORED", "LICENSED_SOURCE", "PUBLIC_DOMAIN_SOURCE", "GENERATED", "OWNER_REVIEW"]
    },
    "sourceName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "licenseName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "attributionText": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/localizedText" },
      "uniqueItems": true
    },
    "authoredBy": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "accessedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "notes": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["provenanceId", "subjectType", "subjectId", "sourceType", "createdAt"],
  "allOf": [
    {
      "if": { "properties": { "sourceType": { "enum": ["LICENSED_SOURCE", "PUBLIC_DOMAIN_SOURCE"] } }, "required": ["sourceType"] },
      "then": { "required": ["sourceName", "sourceUrl"] }
    }
  ],
  "additionalProperties": false
}
