{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/learning-set.schema.json",
  "title": "VocabFlow Master Learning Set revision",
  "type": "object",
  "properties": {
    "learningSetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "learningSetRevision": { "type": "integer", "minimum": 1 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "name": { "$ref": "common.schema.json#/$defs/localizedTextList" },
    "description": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/localizedText" },
      "uniqueItems": true
    },
    "setKind": {
      "type": "string",
      "enum": ["STARTER", "SEQUENCE", "TOPIC_COLLECTION", "CURRICULUM", "EXAM_PREPARATION", "DOMAIN"]
    },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "RETIRED"] },
    "sortOrder": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/learningSetItem" },
      "uniqueItems": true
    },
    "selectionProvenanceIds": { "$ref": "common.schema.json#/$defs/provenanceIds" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["learningSetId", "learningSetRevision", "code", "name", "setKind", "status", "items", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "$defs": {
    "learningSetItem": {
      "type": "object",
      "properties": {
        "learningSetItemId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "learningSetId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "masterSenseId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "position": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "common.schema.json#/$defs/reviewStatus" },
        "addedByProvenanceId": { "$ref": "common.schema.json#/$defs/uuidV7" }
      },
      "required": ["learningSetItemId", "learningSetId", "masterSenseId", "position", "status"],
      "additionalProperties": false
    }
  }
}
