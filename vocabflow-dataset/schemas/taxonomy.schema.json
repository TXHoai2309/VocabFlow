{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/taxonomy.schema.json",
  "title": "VocabFlow Master Vocabulary V2 taxonomy snapshot",
  "type": "object",
  "properties": {
    "taxonomyId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "taxonomyVersion": { "$ref": "common.schema.json#/$defs/semVer" },
    "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "RETIRED"] },
    "cefrFrameworks": { "type": "array", "items": { "$ref": "#/$defs/cefrFramework" }, "uniqueItems": true },
    "topics": { "type": "array", "items": { "$ref": "#/$defs/topic" }, "uniqueItems": true },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "uniqueItems": true },
    "exams": { "type": "array", "items": { "$ref": "#/$defs/exam" }, "uniqueItems": true },
    "curricula": { "type": "array", "items": { "$ref": "#/$defs/curriculum" }, "uniqueItems": true },
    "schoolLevels": { "type": "array", "items": { "$ref": "#/$defs/schoolLevel" }, "uniqueItems": true },
    "difficultyScales": { "type": "array", "items": { "$ref": "#/$defs/difficultyScale" }, "uniqueItems": true },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["taxonomyId", "taxonomyVersion", "status", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "$defs": {
    "cefrFramework": {
      "type": "object",
      "properties": {
        "frameworkCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "frameworkVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "descriptors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "valueCode": { "type": "string", "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1", "C2"] },
              "language": { "$ref": "common.schema.json#/$defs/languageTag" },
              "text": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "provenanceIds": { "$ref": "common.schema.json#/$defs/provenanceIds" }
            },
            "required": ["valueCode", "language", "text"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["frameworkCode", "frameworkVersion", "labels", "status"],
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "properties": {
        "topicId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "definition": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/localizedText" }, "uniqueItems": true },
        "parentTopicId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["topicId", "code", "labels", "status"],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "domainId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "definition": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/localizedText" }, "uniqueItems": true },
        "parentDomainId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["domainId", "code", "labels", "status"],
      "additionalProperties": false
    },
    "exam": {
      "type": "object",
      "properties": {
        "examId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "familyCode": { "type": "string", "enum": ["IELTS", "TOEIC", "TOEFL", "CAMBRIDGE", "VSTEP", "OTHER"] },
        "authority": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "edition": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "track": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["examId", "code", "familyCode", "labels", "status"],
      "additionalProperties": false
    },
    "curriculum": {
      "type": "object",
      "properties": {
        "curriculumId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "jurisdiction": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "authority": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "edition": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["curriculumId", "code", "jurisdiction", "labels", "status"],
      "additionalProperties": false
    },
    "schoolLevel": {
      "type": "object",
      "properties": {
        "schoolLevelId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "curriculumId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "gradeNumber": { "type": "integer", "minimum": 1, "maximum": 12 },
        "levelCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] },
        "sortOrder": { "type": "integer", "minimum": 0 }
      },
      "required": ["schoolLevelId", "curriculumId", "levelCode", "labels", "status", "sortOrder"],
      "additionalProperties": false
    },
    "difficultyScale": {
      "type": "object",
      "properties": {
        "scaleId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "scaleVersion": { "$ref": "common.schema.json#/$defs/semVer" },
        "labels": { "$ref": "common.schema.json#/$defs/localizedTextList" },
        "targetLearnerContext": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "rubricVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "scoreMethod": { "type": "string", "enum": ["EDITORIAL", "PILOT_CALIBRATED", "EMPIRICAL_MODEL"] },
        "modelVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] }
      },
      "required": ["scaleId", "scaleVersion", "labels", "targetLearnerContext", "rubricVersion", "scoreMethod", "status"],
      "additionalProperties": false
    }
  }
}
