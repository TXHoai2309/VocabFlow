{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/common.schema.json",
  "title": "VocabFlow Master Vocabulary V2 shared definitions",
  "$defs": {
    "uuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical lowercase UUID text with UUID version 7 and the RFC variant bits."
    },
    "languageTag": {
      "type": "string",
      "format": "language-tag",
      "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[ix]-[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*)$",
      "description": "BCP 47 language tag. The custom language-tag format must be checked against the IANA Language Subtag Registry."
    },
    "semVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Full lowercase SHA-256 hex digest."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "recordStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "RETIRED", "MERGED"]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "RETIRED"]
    },
    "localizedText": {
      "type": "object",
      "properties": {
        "language": { "$ref": "#/$defs/languageTag" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["language", "text"],
      "additionalProperties": false
    },
    "localizedTextList": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedText" },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenanceIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuidV7" },
      "uniqueItems": true
    },
    "pronunciation": {
      "type": "object",
      "properties": {
        "pronunciationId": { "$ref": "#/$defs/uuidV7" },
        "masterLexemeId": { "$ref": "#/$defs/uuidV7" },
        "masterSenseId": { "$ref": "#/$defs/uuidV7" },
        "locale": { "$ref": "#/$defs/languageTag" },
        "accentCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "ipa": { "$ref": "#/$defs/nonEmptyString" },
        "pronunciationNotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/localizedText" },
          "uniqueItems": true
        },
        "audioAssetId": { "$ref": "#/$defs/uuidV7" },
        "isPreferred": { "type": "boolean" },
        "status": { "$ref": "#/$defs/reviewStatus" }
      },
      "required": ["pronunciationId", "locale", "isPreferred", "status"],
      "oneOf": [
        {
          "required": ["masterLexemeId"],
          "not": { "required": ["masterSenseId"] }
        },
        {
          "required": ["masterSenseId"],
          "not": { "required": ["masterLexemeId"] }
        }
      ],
      "additionalProperties": false
    },
    "lexemePronunciation": {
      "allOf": [
        { "$ref": "#/$defs/pronunciation" },
        {
          "required": ["masterLexemeId"],
          "not": { "required": ["masterSenseId"] }
        }
      ]
    },
    "sensePronunciation": {
      "allOf": [
        { "$ref": "#/$defs/pronunciation" },
        {
          "required": ["masterSenseId"],
          "not": { "required": ["masterLexemeId"] }
        }
      ]
    },
    "classification": {
      "type": "object",
      "properties": {
        "classificationId": { "$ref": "#/$defs/uuidV7" },
        "classificationRevision": { "type": "integer", "minimum": 1 },
        "masterSenseId": { "$ref": "#/$defs/uuidV7" },
        "dimension": {
          "type": "string",
          "enum": ["CEFR", "DIFFICULTY", "AGE_GROUP", "SCHOOL_LEVEL", "TOPIC", "DOMAIN", "EXAM"]
        },
        "frameworkCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "frameworkVersion": { "$ref": "#/$defs/nonEmptyString" },
        "valueCode": {
          "type": "string",
          "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1", "C2", "KIDS", "TEEN", "ADULT"]
        },
        "valueRef": { "$ref": "#/$defs/uuidV7" },
        "numericValue": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scaleId": { "$ref": "#/$defs/uuidV7" },
        "isPrimary": { "type": "boolean" },
        "sourceProvenanceIds": { "$ref": "#/$defs/provenanceIds" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "validTo": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["classificationId", "classificationRevision", "masterSenseId", "dimension", "isPrimary", "status"],
      "oneOf": [
        {
          "properties": {
            "dimension": { "const": "CEFR" },
            "valueCode": { "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1", "C2"] }
          },
          "required": ["dimension", "valueCode", "frameworkCode", "frameworkVersion"],
          "not": { "anyOf": [{ "required": ["valueRef"] }, { "required": ["numericValue"] }, { "required": ["scaleId"] }] }
        },
        {
          "properties": {
            "dimension": { "const": "AGE_GROUP" },
            "valueCode": { "enum": ["KIDS", "TEEN", "ADULT"] }
          },
          "required": ["dimension", "valueCode"],
          "not": { "anyOf": [{ "required": ["frameworkCode"] }, { "required": ["frameworkVersion"] }, { "required": ["valueRef"] }, { "required": ["numericValue"] }, { "required": ["scaleId"] }] }
        },
        {
          "properties": { "dimension": { "enum": ["TOPIC", "DOMAIN", "EXAM", "SCHOOL_LEVEL"] } },
          "required": ["dimension", "valueRef"],
          "not": { "anyOf": [{ "required": ["frameworkCode"] }, { "required": ["frameworkVersion"] }, { "required": ["valueCode"] }, { "required": ["numericValue"] }, { "required": ["scaleId"] }] }
        },
        {
          "properties": { "dimension": { "const": "DIFFICULTY" } },
          "required": ["dimension", "numericValue", "scaleId"],
          "not": { "anyOf": [{ "required": ["frameworkCode"] }, { "required": ["frameworkVersion"] }, { "required": ["valueCode"] }, { "required": ["valueRef"] }] }
        }
      ],
      "additionalProperties": false
    },
    "classificationPin": {
      "type": "object",
      "properties": {
        "classificationId": { "$ref": "#/$defs/uuidV7" },
        "classificationRevision": { "type": "integer", "minimum": 1 },
        "recordPath": { "$ref": "#/$defs/nonEmptyString" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      },
      "required": ["classificationId", "classificationRevision", "recordPath", "contentHash"],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "relationId": { "$ref": "#/$defs/uuidV7" },
        "relationRevision": { "type": "integer", "minimum": 1 },
        "fromEntityType": { "type": "string", "enum": ["LEXEME", "SENSE"] },
        "fromId": { "$ref": "#/$defs/uuidV7" },
        "toEntityType": { "type": "string", "enum": ["LEXEME", "SENSE"] },
        "toId": { "$ref": "#/$defs/uuidV7" },
        "relationType": { "type": "string", "enum": ["SYNONYM", "ANTONYM", "RELATED", "DERIVATIVE", "VARIANT_OF"] },
        "directionality": { "type": "string", "enum": ["SYMMETRIC", "DIRECTED"] },
        "provenanceIds": { "$ref": "#/$defs/provenanceIds" },
        "status": { "$ref": "#/$defs/reviewStatus" }
      },
      "required": ["relationId", "relationRevision", "fromEntityType", "fromId", "toEntityType", "toId", "relationType", "directionality", "status"],
      "additionalProperties": false
    },
    "pinnedRecordBase": {
      "type": "object",
      "properties": {
        "recordPath": { "$ref": "#/$defs/nonEmptyString" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      },
      "required": ["recordPath", "contentHash"]
    }
  }
}
