{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vocabflow.invalid/master-vocabulary/v2/lexeme.schema.json",
  "title": "VocabFlow Master Lexeme revision",
  "type": "object",
  "properties": {
    "masterLexemeId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "lexemeRevision": { "type": "integer", "minimum": 1 },
    "language": { "$ref": "common.schema.json#/$defs/languageTag" },
    "lemma": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "normalizedLemma": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "normalizationPolicyVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "lexicalUnitType": {
      "type": "string",
      "enum": ["WORD", "MULTIWORD_EXPRESSION", "PHRASAL_VERB", "IDIOM"]
    },
    "displayOrder": { "type": "integer", "minimum": 0 },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "uniqueItems": true
    },
    "pronunciations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/lexemePronunciation" },
      "uniqueItems": true
    },
    "status": { "$ref": "common.schema.json#/$defs/recordStatus" },
    "mergedIntoLexemeId": { "$ref": "common.schema.json#/$defs/uuidV7" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": [
    "masterLexemeId", "lexemeRevision", "language", "lemma", "normalizedLemma",
    "normalizationPolicyVersion", "lexicalUnitType", "status", "createdAt", "updatedAt"
  ],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "MERGED" } }, "required": ["status"] },
      "then": { "required": ["mergedIntoLexemeId"] },
      "else": { "not": { "required": ["mergedIntoLexemeId"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "alias": {
      "type": "object",
      "properties": {
        "language": { "$ref": "common.schema.json#/$defs/languageTag" },
        "form": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "status": { "type": "string", "enum": ["ACTIVE", "RETIRED"] },
        "provenanceIds": { "$ref": "common.schema.json#/$defs/provenanceIds" }
      },
      "required": ["language", "form", "status"],
      "additionalProperties": false
    }
  }
}
