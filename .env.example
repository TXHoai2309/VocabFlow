# Local development target. Never use this file for real credentials.
VOCABFLOW_ENV=development
DATABASE_ENV=development
EXECUTION_CONTEXT=local-development
TRUSTED_SOURCE=dev-launcher
DATABASE_URL=postgresql://vocabflow_runtime:password@ep-example.us-east-2.aws.neon.tech/vocabflow?sslmode=require
DATABASE_MIGRATION_URL=postgresql://vocabflow_migration:password@ep-example.us-east-2.aws.neon.tech/vocabflow?sslmode=require
DATABASE_IDENTITY_PROVISION_URL=postgresql://vocabflow_identity_provision:password@ep-example.us-east-2.aws.neon.tech/vocabflow?sslmode=require

# Trusted DB integration only. Never expose these to browser code or fork PRs.
NEON_TEST_DATABASE_URL=
NEON_TEST_MIGRATION_DATABASE_URL=
NEON_TEST_IDENTITY_PROVISION_DATABASE_URL=
NEON_TEST_RUNTIME_DATABASE_URL=
NEON_API_KEY=
BOOTSTRAP_DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-a-local-only-secret
